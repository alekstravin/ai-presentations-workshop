# Save as .env in a private gateway directory; chmod 600 .env
GPT2GIGA_MODE=PROD
GPT2GIGA_HOST=127.0.0.1
GPT2GIGA_PORT=8090
GPT2GIGA_ENABLE_API_KEY_AUTH=True
GPT2GIGA_API_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
GIGACHAT_CREDENTIALS=REPLACE_WITH_AUTHORIZATION_KEY
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=True
# If the SDK cannot validate your CA chain, use the verified CA bundle:
# GIGACHAT_CA_BUNDLE_FILE=/absolute/path/to/verified-ca-bundle.pem
